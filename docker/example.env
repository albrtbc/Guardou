# Required values
# ===================================================================
# The path to store files, db and settings
DATA_PATH=./guardou_data

# Optional Values
# ===================================================================
# PUID=1000
# PGID=1000

# Reverse proxy
# ===================================================================
# Comma-separated IPs or CIDR ranges of the reverse proxies in front of Guardou.
# List only the direct proxies, the ones that connect to Guardou, never a whole network
# that also holds other containers. Only these may set X-Forwarded-For and
# X-Forwarded-Proto (one hop). Empty trusts none (apart from loopback), so cookies are not
# marked Secure behind TLS and the rate limits see the proxy address.
# TRUSTED_PROXIES=172.18.0.2

# Optional overrides of the admin settings
# ===================================================================
# EXTERNAL_URL=https://guardou.example.com
# TRASH_RETENTION_DAYS=30
# UPLOAD_CONCURRENCY=3
# UPLOAD_CHUNK_SIZE_MB=64
# Largest file a user can upload, in MB. Unset means no limit.
# MAX_FILE_SIZE_MB=10240
# Free space the server keeps, in MB. Uploads and copies that would leave less are
# refused (507), counting the bytes still pending in unfinished uploads of all users.
# MIN_FREE_SPACE_MB=1024

# OIDC Settings
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=guardou
# OIDC_CLIENT_SECRET=secret
# OIDC_SCOPES=openid profile email
# OIDC_USER_CLAIM=preferred_username
